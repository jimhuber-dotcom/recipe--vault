NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Not used yet (the app shell needs no admin access). Left here so it is
# configured server-side before the phases that need it.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only — powers photo → recipe extraction (Claude vision). Get a key at
